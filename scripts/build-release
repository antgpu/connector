#!/usr/bin/env bash
set -euo pipefail
version="${1:?release version required}"
[[ "$version" =~ ^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$ ]] || { echo "invalid version" >&2; exit 1; }
module="$(go list -m)"
public_key="$(tr -d '\r\n' < .github/connector-update.pub)"
[[ "$public_key" =~ ^[A-Za-z0-9+/]{43}=$ ]] || { echo "invalid pinned public key" >&2; exit 1; }
mkdir -p "dist/$version"
for arch in amd64 arm64; do
  CGO_ENABLED=0 GOOS=linux GOARCH="$arch" go build -trimpath \
    -ldflags "-s -w -X main.AppVersion=$version -X $module/internal/updater.TrustedPublicKey=$public_key" \
    -o "dist/$version/connect-linux-$arch" ./cmd/connect
done
